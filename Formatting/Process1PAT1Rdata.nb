 RowBox[{
  RowBox[{"FluxAngMomHor0PA", "=", 
   RowBox[{"(*", 
    RowBox[{
     SuperscriptBox["pGrid0PA", 
      RowBox[{"3", "/", "2"}]], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["32", "5"], 
        SuperscriptBox["yGrid0PA", "9"], "FluxHor0PA"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["32", "5"], 
        SuperscriptBox["pGrid0PA", 
         RowBox[{
          RowBox[{"-", "15"}], "/", "2"}]]}], ")"}]}]}], "*)"}], 
