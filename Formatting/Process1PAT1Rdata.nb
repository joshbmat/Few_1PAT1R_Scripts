Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EFLx", "[", "x_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"z", "[", "x", "]"}]}], "-", 
     RowBox[{
      RowBox[{"x", "/", "3"}], 
      RowBox[{
       RowBox[{"z", "'"}], "[", "x", "]"}]}], "-", "1", "+", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"3", "x"}]}], "]"}], "+", 
     RowBox[{
      RowBox[{"x", "/", "6"}], "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"7", "-", 
         RowBox[{"24", "x"}]}], ")"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"3", "x"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "2"}], ")"}]}]}]}]}], ")"}]}], ";"}]], "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"a8edfc8f-418e-442b-b678-1689add7be83"]
}, Closed]],

