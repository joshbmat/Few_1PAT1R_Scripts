Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m1", "=", 
       SuperscriptBox["10", "6"]}], ",", 
      RowBox[{"m2", "=", "10"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Nu]", "=", 
       FractionBox[
        RowBox[{"m1", " ", "m2"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"m1", "+", "m2"}], ")"}], "2"]]}], ",", 
      RowBox[{"\[Epsilon]", "=", 
       FractionBox["m2", "m1"]}]}], "}"}], ",", 
    RowBox[{
     FractionBox["a", "\[Epsilon]"], "/.", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"Interpolation", "[", "\[CapitalDelta]\[Phi]data", "]"}], "[",
           "a", "]"}], "\[Epsilon]"], "==", "\[CapitalDelta]\[Phi]1PAlimit"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "0"}], "}"}]}], "]"}]}]}], "]"}], "//", 
  "N"}]], "Input",
