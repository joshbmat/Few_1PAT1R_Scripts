               SuperscriptBox["y", 
                RowBox[{"3", "/", "2"}]]], ")"}], 
             RowBox[{"2", "/", "3"}]]}], "]"}], "-", 
          RowBox[{"\[ScriptCapitalF]Schw", "[", 
           RowBox[{"1", "/", "y"}], "]"}]}], ")"}], "]"}]}], "}"}], ",", 
