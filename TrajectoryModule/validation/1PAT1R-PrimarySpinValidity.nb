   RowBox[{
    RowBox[{"\[CapitalDelta]\[Phi]data", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"a", "==", "0"}], ",", "0", ",", 
           RowBox[{"\[CapitalDelta]\[Phi]", "[", "a", "]"}]}], "]"}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", 
         RowBox[{"-", "0.5"}], ",", "0.5", ",", "0.01"}], "}"}]}], "]"}]}], 
    ";"}], ",", "a"}], "]"}]], "Input",
