  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", "=", "0.01"}], "}"}], ",", 
   RowBox[{"LogLogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"\[ScriptCapitalF]KerrLinear", "[", 
          RowBox[{"a", ",", 
           RowBox[{"1", "/", "y"}]}], "]"}], "-", 
         RowBox[{"\[ScriptCapitalF]Schw", "[", 
          RowBox[{"1", "/", "y"}], "]"}]}], "]"}], ",", 
       RowBox[{"Abs", "[", 
