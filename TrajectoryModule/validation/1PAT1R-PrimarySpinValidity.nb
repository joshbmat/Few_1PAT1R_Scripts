  RowBox[{"\[CapitalDelta]\[Phi]", "[", "a_", "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     FractionBox["\[CapitalOmega]0", 
      FractionBox[
       RowBox[{"\[ScriptCapitalF]Kerr", "[", 
        RowBox[{"a", ",", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"1", "-", 
             RowBox[{"a", " ", "\[CapitalOmega]0"}]}], "\[CapitalOmega]0"], 
           ")"}], 
          RowBox[{"2", "/", "3"}]]}], "]"}], 
       RowBox[{"dE0d\[CapitalOmega]", "[", 
        RowBox[{"a", ",", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"1", "-", 
             RowBox[{"a", " ", "\[CapitalOmega]0"}]}], "\[CapitalOmega]0"], 
           ")"}], 
          RowBox[{"2", "/", "3"}]]}], "]"}]]], "-", 
     FractionBox["\[CapitalOmega]0", 
      FractionBox[
       RowBox[{"\[ScriptCapitalF]KerrLinear", "[", 
        RowBox[{"a", ",", 
         SuperscriptBox["\[CapitalOmega]0", 
          RowBox[{
           RowBox[{"-", "2"}], "/", "3"}]]}], "]"}], 
       RowBox[{"dE0d\[CapitalOmega]Linear", "[", 
        RowBox[{"a", ",", 
         SuperscriptBox["\[CapitalOmega]0", 
          RowBox[{
           RowBox[{"-", "2"}], "/", "3"}]]}], "]"}]]]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]0", ",", 
      SuperscriptBox["15", 
       RowBox[{
        RowBox[{"-", "3"}], "/", "2"}]], ",", 
      SuperscriptBox["6.25", 
       RowBox[{
        RowBox[{"-", "3"}], "/", "2"}]]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.98473437290983*^9, 3.984734421656506*^9}, {
  3.984737232622734*^9, 3.9847372331288433`*^9}, {3.984792395786956*^9, 
