Cell[TextData[{
 "So our total fluxes have a precision around ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]], TraditionalForm]],ExpressionUUID->
  "a2c39110-5ffc-4875-b02f-9fe5a4da9847"],
 " at worst. Note the horizon flux has a higher relative error but is smaller \
in absolute terms than the infinity flux:"
}], "Text",
 CellChangeTimes->{{3.985325247003669*^9, 3.985325315854569*^9}, {
  3.98532534600487*^9, 3.985325362767994*^9}, {3.985573544022449*^9, 
  3.985573565919475*^9}, {3.985574259986371*^9, 
  3.9855742602495213`*^9}},ExpressionUUID->"a97bfdf8-450a-4026-9a27-\
b9b03a1d3f86"],

