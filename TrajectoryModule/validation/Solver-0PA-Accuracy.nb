Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]\[Epsilon]sol", "[", "\[Epsilon]", "]"}], ",", 
       
       RowBox[{"\[Phi]\[Epsilon]sol", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"r0\[Epsilon]sol", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "'"}], "[", "t", "]"}], "\[Equal]", 
          FractionBox[
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"3", " ", 
                RowBox[{"M", "/", 
                 RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}], 
             RowBox[{"3", "/", "2"}]], " ", 
            SqrtBox[
             RowBox[{"M", "/", 
              RowBox[{"r0", "[", "t", "]"}]}]], " ", 
            RowBox[{"\[ScriptCapitalF]\[ScriptCapitalE]", "[", 
             RowBox[{"r0", "[", "t", "]"}], "]"}], " ", "\[Epsilon]"}], 
           RowBox[{
            SuperscriptBox["M", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"6", " ", 
               RowBox[{"M", "/", 
                RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}]}]]}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "\[Epsilon]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "==", 
          RowBox[{"Sqrt", "[", 
           FractionBox["M", 
            SuperscriptBox[
             RowBox[{"r0", "[", "t", "]"}], "3"]], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"r0", "[", "0", "]"}], "\[Equal]", 
          RowBox[{"15", "M"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r0", "[", "t", "]"}], "\[LessEqual]", 
            RowBox[{"6.1", "M"}]}], ",", " ", "\"\<StopIntegration\>\""}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "\[Phi]", ",", "r0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tmin\[Epsilon]", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"tmax\[Epsilon]", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"r0sol", "[", "\[Epsilon]", "]"}], "[", "\"\<Domain\>\"", 
       "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", "\[Epsilon]s"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.985325834695066*^9, 3.985326040356366*^9}, {
