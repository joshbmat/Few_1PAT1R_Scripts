Cell[CellGroupData[{

Cell["Check accuracy of interpolants", "Subsubsection",
 CellChangeTimes->{{3.985324837601386*^9, 
  3.985324844115532*^9}},ExpressionUUID->"20761753-a5eb-443b-8697-\
4b3d6b6bee0f"],

Cell["\<\
Validate by trying a less dense grid and a higher order interpolant:\
\>", "Text",
 CellChangeTimes->{{3.985324969407516*^9, 3.9853249812538843`*^9}, {
  3.985350474563953*^9, 
  3.9853504752612543`*^9}},ExpressionUUID->"dc8c5b67-dc4c-43df-9cdb-\
6871f8a33c80"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "\[ScriptCapitalF]\[ScriptCapitalE]\[ScriptCapitalI]2", "[", "p_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     FractionBox["32", "5"], 
     SuperscriptBox["p", 
      RowBox[{"-", "5"}]], 
     RowBox[{
      RowBox[{"Interpolation", "[", 
       RowBox[{
        RowBox[{"Downsample", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"pGrid", ",", 
             
             FractionBox[
              "\[ScriptCapitalF]\[ScriptCapitalE]\[ScriptCapitalI]data", 
              RowBox[{
               FractionBox["32", "5"], 
               SuperscriptBox["pGrid", 
                RowBox[{"-", "5"}]]}]]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"InterpolationOrder", "->", "8"}]}], "]"}], "[", "p", "]"}]}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985324016574819*^9, 3.985324076148876*^9}, {
   3.985324147449131*^9, 3.985324176343863*^9}, {3.9853242336618223`*^9, 
