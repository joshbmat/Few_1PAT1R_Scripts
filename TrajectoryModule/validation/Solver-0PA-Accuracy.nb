Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", "=", 
     SuperscriptBox["10", 
      RowBox[{"-", "5"}]]}], "}"}], ",", 
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[Phi]sol", "[", "\[Epsilon]", "]"}], "[", "t", "]"}], "-", 
        
