Cell[CellGroupData[{

Cell["0PA inspiral", "Section",
 CellChangeTimes->{{3.985325382388026*^9, 
  3.985325384524392*^9}},ExpressionUUID->"519c2be0-f358-4113-862f-\
771d35dd98d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", "=", "1"}], ";"}]], "Input",
 CellChangeTimes->{{3.985325953947294*^9, 3.9853259550928793`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"cd02986d-2d3d-41ec-9954-a18beac160ae"],

Cell[TextData[{
 "Study a range of mass ratios from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    SuperscriptBox["10", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8144047d-0d7d-43b8-af3f-700242ea8b1b"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "10"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b05a8f6-a7b1-4928-9545-bd545070dedc"]
}], "Text",
 CellChangeTimes->{{3.9853334157047167`*^9, 
  3.985333443775258*^9}},ExpressionUUID->"30796971-93bf-4133-b29d-\
db09f3526273"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Epsilon]s", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "9"}], "]"}]}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.985333972415009*^9, 3.985333974353837*^9}, 
   3.985338730869823*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"6e29119a-58d1-49b3-ae4f-4998b1df3c67"],

Cell[CellGroupData[{

Cell["Standard inspiral and default NDSolve options", "Subsection",
 CellChangeTimes->{{3.985326123327004*^9, 3.98532612851394*^9}, {
  3.985333099084257*^9, 
  3.9853331143275347`*^9}},ExpressionUUID->"412e02f2-a49e-4724-b0ed-\
744ea64f5385"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]sol", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"\[Phi]sol", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"r0sol", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "'"}], "[", "t", "]"}], "\[Equal]", 
          FractionBox[
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"3", " ", 
                RowBox[{"M", "/", 
                 RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}], 
             RowBox[{"3", "/", "2"}]], " ", 
            SqrtBox[
             RowBox[{"M", "/", 
              RowBox[{"r0", "[", "t", "]"}]}]], " ", 
            RowBox[{"\[ScriptCapitalF]\[ScriptCapitalE]", "[", 
             RowBox[{"r0", "[", "t", "]"}], "]"}], " ", "\[Epsilon]"}], 
           RowBox[{
            SuperscriptBox["M", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"6", " ", 
               RowBox[{"M", "/", 
                RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}]}]]}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "==", 
          RowBox[{"Sqrt", "[", 
           FractionBox["M", 
            SuperscriptBox[
             RowBox[{"r0", "[", "t", "]"}], "3"]], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"r0", "[", "0", "]"}], "\[Equal]", 
          RowBox[{"15", "M"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r0", "[", "t", "]"}], "\[LessEqual]", 
            RowBox[{"6.1", "M"}]}], ",", " ", "\"\<StopIntegration\>\""}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "\[Phi]", ",", "r0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tmin", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"tmax", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"r0sol", "[", "\[Epsilon]", "]"}], "[", "\"\<Domain\>\"", 
       "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", "\[Epsilon]s"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.985325834695066*^9, 3.985326040356366*^9}, {
