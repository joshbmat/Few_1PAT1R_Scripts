Cell[CellGroupData[{

Cell["Higher accuracy flux data interpolation", "Subsubsection",
 CellChangeTimes->{{3.985326123327004*^9, 3.98532612851394*^9}, {
  3.985333099084257*^9, 3.9853331143275347`*^9}, {3.985333266349551*^9, 
  3.9853332719405937`*^9}, {3.98533335353723*^9, 3.985333373630825*^9}, {
