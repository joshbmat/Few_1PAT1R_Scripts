  3.985405468055818*^9}},ExpressionUUID->"9550f32b-350d-4335-9d78-\
48da54d679ae"],

Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]sol3", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"\[Phi]sol3", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"r0sol3", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "'"}], "[", "t", "]"}], "\[Equal]", 
          FractionBox[
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"3", " ", 
                RowBox[{"M", "/", 
                 RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}], 
             RowBox[{"3", "/", "2"}]], " ", 
            SqrtBox[
             RowBox[{"M", "/", 
              RowBox[{"r0", "[", "t", "]"}]}]], " ", 
            RowBox[{"\[ScriptCapitalF]\[ScriptCapitalE]3", "[", 
             RowBox[{"r0", "[", "t", "]"}], "]"}], " ", "\[Epsilon]"}], 
           RowBox[{
            SuperscriptBox["M", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"6", " ", 
               RowBox[{"M", "/", 
                RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}]}]]}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], "==", 
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "==", 
          RowBox[{"Sqrt", "[", 
           FractionBox["M", 
            SuperscriptBox[
             RowBox[{"r0", "[", "t", "]"}], "3"]], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"r0", "[", "0", "]"}], "\[Equal]", 
          RowBox[{"15", "M"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r0", "[", "t", "]"}], "\[LessEqual]", 
            RowBox[{"6.1", "M"}]}], ",", " ", "\"\<StopIntegration\>\""}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "\[Phi]", ",", "r0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "\[Infinity]"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tmin3", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"tmax3", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"r0sol3", "[", "\[Epsilon]", "]"}], "[", "\"\<Domain\>\"", 
       "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", "\[Epsilon]s"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.985325834695066*^9, 3.985326040356366*^9}, {
   3.985326092698344*^9, 3.9853260932625933`*^9}, {3.985326214740563*^9, 
   3.985326248761726*^9}, 3.985326957073206*^9, {3.98532788190653*^9, 
   3.985327898594636*^9}, {3.9853332895358343`*^9, 3.98533329786329*^9}, {
   3.985333394795891*^9, 3.985333403006357*^9}, 3.9853339861805964`*^9, {
   3.985405473075943*^9, 3.985405487123838*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"419111c8-c5e1-4288-b52f-6c52b24e740d"],

