  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.985500906080991*^9, 3.985936805231571*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"4dfd3839-f46e-4134-b53e-67255ce935e8"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetAmpsAtr0Combined", "[", 
   RowBox[{
   "r0_", ",", "l_", ",", "m_", ",", "\[Nu]_", ",", "chit1_", ",", "chit2_", ",",
     "deltam1_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"modestring", ",", "string1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
