Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Tick", " ", "helper"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"niceFrameTicks", "[", 
     RowBox[{"min_", ",", "max_", ",", 
      RowBox[{"n_", ":", "5"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", "#", "]"}], ",", "3"}], "]"}]}], "}"}], "&"}], "/@", 
     RowBox[{"FindDivisions", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"min", ",", "max"}], "}"}], ",", "n"}], "]"}]}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "options"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOpts", "=", 
     RowBox[{"Sequence", "[", 
      RowBox[{
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "4"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontSize", "->", "14"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Re[\[CapitalDelta]h]\>\"", ",", "None"}], "}"}], ",", 
          
          RowBox[{"{", 
           RowBox[{"\"\<t (s)\>\"", ",", "None"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "14"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Precompute", " ", "only", " ", "the", " ", "needed", " ", "segments"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tFEWFirst", "=", 
     RowBox[{"tFEW", "[", 
      RowBox[{"[", 
       RowBox[{";;", "1000"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tFEWLast", "=", 
     RowBox[{"tFEW", "[", 
      RowBox[{"[", 
       RowBox[{"22314134", ";;"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"diffFirst", "=", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"\[Nu]val", "*", "Mval", "*", 
        RowBox[{"waveformFEW", "[", 
         RowBox[{"[", 
          RowBox[{";;", "1000"}], "]"}], "]"}]}], "]"}], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"waveform", "[", "#", "]"}], "]"}], "&"}], "/@", 
        "tFEWFirst"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"diffLast", "=", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"\[Nu]val", "*", "Mval", "*", 
        RowBox[{"waveformFEW", "[", 
         RowBox[{"[", 
          RowBox[{"22314134", ";;"}], "]"}], "]"}]}], "]"}], "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"waveform", "[", "#", "]"}], "]"}], "&"}], "/@", 
        "tFEWLast"}], ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Early", " ", "difference"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"first1000sDiff", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tFEWFirst", ",", "diffFirst"}], "}"}], "]"}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "3"}], "]"}]}], ",", "plotOpts", ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"niceFrameTicks", "[", 
             RowBox[{"0", ",", "1000"}], "]"}], ",", "None"}], "}"}]}], 
         "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Late", " ", "difference"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"last1000sDiff", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tFEWLast", ",", "diffLast"}], "}"}], "]"}], ",", 
       RowBox[{"Joined", "->", "True"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "3"}], "]"}]}], ",", "plotOpts", ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"niceFrameTicks", "[", 
             RowBox[{"22314134", ",", "22315134"}], "]"}], ",", "None"}], 
           "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Combined", " ", "labelled", " ", "grid"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Labeled", "[", 
         RowBox[{"first1000sDiff", ",", 
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Early inspiral (t = 0\[Dash]1000 s)\>\"", ",", "14", ",",
             "Bold"}], "]"}], ",", "Top"}], "]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Labeled", "[", 
         RowBox[{"last1000sDiff", ",", 
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Late inspiral (t = 22314134\[Dash]22315134 s)\>\"", ",",
             "14", ",", "Bold"}], "]"}], ",", "Top"}], "]"}], "}"}]}], "}"}], 
     ",", 
     RowBox[{"Spacings", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "800"}]}], "]"}]}]}]], "Input",
