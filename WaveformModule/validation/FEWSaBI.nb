Cell["\<\
In the late inspiral, the difference has grown. Check trajectory via looking \
at phase difference - the error does not seem to be caused by the wasabi \
integration settings.\
\>", "Text",
 CellChangeTimes->{{3.9859377838876333`*^9, 3.985937816602626*^9}, {
  3.985937922816835*^9, 3.985937928046055*^9}, {3.985940063006062*^9, 
  3.985940097434169*^9}},ExpressionUUID->"ab66f7e7-44f5-42c3-9e7f-\
98be3847d285"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "PyBlock", 
   "[", "\"\<\nfrom few.trajectory.inspiral import EMRIInspiral\nfrom \
few.trajectory.ode.IPAT1R import Trajectory1PAT1R\n\ntraj = \
EMRIInspiral(func=Trajectory1PAT1R)\n\nt_traj, p_traj, e_traj, x_traj, \
Phi_phi_traj, Phi_theta_traj, Phi_r_traj, deltaM_traj, deltachit1_traj = \
traj(\n    m1, m2,\n    a,        \n    p0,\n    0.0,      \n    1.0,      \n \
   chi2,     \n    T=T,\n    dt=dt\n)\n\>\"", "]"}], "//", 
  "ToExpression"}]], "Input",
 CellChangeTimes->{{3.98593825794627*^9, 3.985938296038416*^9}, {
  3.9859383979240437`*^9, 3.985938416465622*^9}, {3.985938456705749*^9, 
  3.985938458700486*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"a8514427-ffca-4ee8-bed7-5c04c74f737f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tTraj", "=", 
   RowBox[{"py", "[", "\"\<t_traj.tolist()\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pTraj", "=", 
   RowBox[{"py", "[", "\"\<p_traj.tolist()\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PhiPhiTraj", "=", 
   RowBox[{"py", "[", "\"\<Phi_phi_traj.tolist()\>\"", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9859391136758432`*^9, 3.985939113678495*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"7b98a151-56f3-40d7-935d-022b1554e4f4"],

Cell["\<\
We find the phase accuracy is consistent with the ODE integrator err \
tolerance, so it\[CloseCurlyQuote]s unlikely to be the WaSABI integration \
settings here:\
\>", "Text",
 CellChangeTimes->{{3.985939546699573*^9, 3.9859395691801367`*^9}, {
  3.9859396299621162`*^9, 
  3.985939645172765*^9}},ExpressionUUID->"1057daf7-3e9d-4dce-a6b5-\
abd2e7e9bbe3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalDelta]\[Phi]", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tTraj", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"wasabiWaveform", "[", "\"\<Trajectory\>\"", "]"}], 
                "[", "\"\<\[Phi]\>\"", "]"}], "[", 
               RowBox[{
                RowBox[{"tTraj", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", 
                RowBox[{"(", "MTSUN", ")"}]}], "]"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"PhiPhiTraj", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ")"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "tTraj", "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"_", ",", "Indeterminate"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"_", ",", "ComplexInfinity"}], "}"}]}], "]"}]}], ";"}]], "Input",\

