Cell[CellGroupData[{

Cell["FEW waveforms in Mathematica:", "Subsubsection",
 CellChangeTimes->{{3.985419686304702*^9, 
  3.985419691357407*^9}},ExpressionUUID->"72eca1e0-4e66-4e91-8bbb-\
24b6e28213a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "PyBlock", 
   "[", "\"\<import numpy as np\nimport matplotlib.pyplot as plt\nfrom \
few.waveform import Waveform1PAT1R, FastKerrEccentricEquatorialFlux\n\nm1 = \
1e6       \nm2 = 10      \nchi1  = 1e-5\na = chi1 \np0 = 9.0      \ntheta = \
np.pi / 3.0   \nphi   = 0.0           \nchi2  = 0.1 \ndt = 1.  \nT  = 1   \n\n\
WF1PAT1R = Waveform1PAT1R()\nh = WF1PAT1R(m1, m2, a, p0, theta, phi, chi2, \
dt=dt, T=T, mode_selection='all')\>\"", "]"}], "//", 
  "ToExpression"}]], "Input",
 CellChangeTimes->{{3.9854187562527227`*^9, 3.98541883384921*^9}, {
  3.9854189070048637`*^9, 3.9854189071806297`*^9}, {3.9854189500770197`*^9, 
  3.985418950402614*^9}, {3.9854189841797647`*^9, 3.985418986451469*^9}, {
  3.985419058790062*^9, 3.985419068105721*^9}, {3.985419447962023*^9, 
  3.985419448903511*^9}, {3.9855007708133*^9, 3.985500770950716*^9}, {
  3.985501693845702*^9, 3.985501705060039*^9}, {3.98550185638743*^9, 
  3.9855018645703173`*^9}, {3.9859339250801287`*^9, 3.985933925639717*^9}, {
  3.9859340256516027`*^9, 3.985934049750923*^9}, {3.9859341275285063`*^9, 
  3.985934129417821*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"15bd2b9d-b547-4fb2-bbcc-67c2ce51a5f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"waveformFEW", "=", 
   RowBox[{"py", "[", "\"\<h.tolist()\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9854189891700687`*^9, 3.985418991197757*^9}, {
   3.98541907776099*^9, 3.9854190779832077`*^9}, 3.985419125892189*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"af8ba55f-7e47-442a-9b3a-0e8c59a393b5"],

