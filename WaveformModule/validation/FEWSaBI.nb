63e6aadfdb38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"session", "=", 
   RowBox[{"StartExternalSession", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<System\>\"", "\[Rule]", "\"\<Python\>\""}], ",", 
      RowBox[{"\"\<Executable\>\"", 
       "\[Rule]", \
"\"\</Users/joshmathews/anaconda3/envs/1pat1r/bin/python\>\""}]}], "|>"}], 
    "]"}]}], ";"}]], "Input",
