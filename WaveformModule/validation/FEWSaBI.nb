 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"0PA\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", "0.03395362728513298`"}], "-", 
     RowBox[{"0.12112709975791676`", " ", "\[ImaginaryI]"}]}]}], ",", 
