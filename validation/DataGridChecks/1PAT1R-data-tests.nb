Cell[BoxData[
 RowBox[{
  RowBox[{"WaSABIEnergy1PA", "[", "x_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"WaSABIz", "[", "x", "]"}]}], "-", 
    RowBox[{
     RowBox[{"x", "/", "3"}], 
     RowBox[{
      RowBox[{"WaSABIz", "'"}], "[", "x", "]"}]}], "-", "1", "+", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", 
      RowBox[{"3", "x"}]}], "]"}], "+", 
    RowBox[{
     RowBox[{"x", "/", "6"}], "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"7", "-", 
        RowBox[{"24", "x"}]}], ")"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"3", "x"}]}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}]}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.9820745512541757`*^9, 3.9820745593125563`*^9}, {
  3.9820746616423645`*^9, 3.982074664475312*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"84a164cf-47ae-4113-b965-7edbcabf866d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dxd\[CapitalOmega]", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "/", 
   RowBox[{"(", 
    RowBox[{"3", " ", 
     RowBox[{"Sqrt", "[", "x", "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9820747917677402`*^9, 3.982074799434024*^9}},
