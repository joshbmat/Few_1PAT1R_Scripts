     RowBox[{"x", "/", "3"}], 
     RowBox[{
      RowBox[{"WaSABIz", "'"}], "[", "x", "]"}]}], "-", "1", "+", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", 
      RowBox[{"3", "x"}]}], "]"}], "+", 
    RowBox[{
     RowBox[{"x", "/", "6"}], "  ", 
