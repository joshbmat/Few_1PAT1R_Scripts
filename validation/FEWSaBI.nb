 RowBox[{
  RowBox[{"GetWaSABIAmpsCombined", "[", 
   RowBox[{"r0_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"fullamp", ",", "modestring"}], "}"}], ",", 
    "\[IndentingNewLine]", 
