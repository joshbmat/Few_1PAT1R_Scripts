Cell[CellGroupData[{

Cell["Getting WaSABI amplitudes", "Subsubsection",
 CellChangeTimes->{{3.982401504182938*^9, 
  3.9824015102469673`*^9}},ExpressionUUID->"ab949f4c-e6f2-4f7c-a02a-\
5149320c8ae3"],

Cell[BoxData[
 RowBox[{"<<", "WaSABI`"}]], "Input",
 CellChangeTimes->{{3.982401273262446*^9, 3.9824012828768883`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"032cc182-83e3-4922-9827-773256394601"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetWaSABIAmps", "[", 
   RowBox[{"r0_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fullamp", ",", "modestring", ",", "amps0PA", ",", "amps1PA", ",", 
      "ampschi2", ",", "ampschi1", ",", "ampsdeltam"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"modestring", "=", 
      RowBox[{"\"\<(\>\"", "<>", 
       RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<,\>\"", "<>", 
       RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<)\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fullamp", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "m", "]"}], ",", 
        RowBox[{
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "-", 
            RowBox[{"4", "\[Nu]"}]}]]], 
         RowBox[{"(*", 
          RowBox[{
          "Accounting", " ", "for", " ", "resummed", " ", "odd", " ", "amp", " ",
            "vs", " ", "raw", " ", "data"}], "*)"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"WaSABI`Waveform`Private`GetAmplitudes", "[", 
             RowBox[{"\"\<1PAT1R\>\"", ",", 
              RowBox[{"{", "}"}]}], "]"}], "/.", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Nu]", "->", "\[Nu]"}], ",", 
              RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[CapitalOmega]", "->", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["r0", "3"]]]}], ",", 
              RowBox[{"WaSABI`Inspiral`Model1PAT1R`M", "->", "1"}], ",", 
              RowBox[{
              "WaSABI`Inspiral`Model1PAT1R`\[Chi]t1", "->", "\[Chi]t1"}], ",", 
              RowBox[{
              "WaSABI`Inspiral`Model1PAT1R`\[Chi]t2", "->", "\[Chi]t2"}], ",", 
              RowBox[{
              "WaSABI`Inspiral`Model1PAT1R`\[Delta]m", "->", "\[Delta]m"}]}], 
             "}"}]}], ")"}], "[", "modestring", "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"WaSABI`Waveform`Private`GetAmplitudes", "[", 
            RowBox[{"\"\<1PAT1R\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}], "/.", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Nu]", "->", "\[Nu]"}], ",", 
             RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[CapitalOmega]", "->", 
              SqrtBox[
               FractionBox["1", 
                SuperscriptBox["r0", "3"]]]}], ",", 
             RowBox[{"WaSABI`Inspiral`Model1PAT1R`M", "->", "1"}], ",", 
             RowBox[{
             "WaSABI`Inspiral`Model1PAT1R`\[Chi]t1", "->", "\[Chi]t1"}], ",", 
             
             RowBox[{
             "WaSABI`Inspiral`Model1PAT1R`\[Chi]t2", "->", "\[Chi]t2"}], ",", 
             
             RowBox[{
             "WaSABI`Inspiral`Model1PAT1R`\[Delta]m", "->", "\[Delta]m"}]}], 
            "}"}]}], ")"}], "[", "modestring", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"amps0PA", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Nu]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Chi]t1", "->", "0"}], ",", 
         RowBox[{"\[Chi]t2", "->", "0"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"amps1PA", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "m", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"fullamp", ",", 
             SuperscriptBox["\[Nu]", "2"]}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Chi]t1", "->", "0"}], ",", 
             RowBox[{"\[Chi]t2", "->", "0"}], ",", 
             RowBox[{"\[Delta]m", "->", "0"}]}], "}"}]}], ")"}], "-", 
         RowBox[{"2", "*", "amps0PA"}]}], ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{"fullamp", ",", 
            SuperscriptBox["\[Nu]", "2"]}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Chi]t1", "->", "0"}], ",", 
            RowBox[{"\[Chi]t2", "->", "0"}], ",", 
            RowBox[{"\[Delta]m", "->", "0"}]}], "}"}]}], ")"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ampschi1", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Chi]t1"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", "->", "1"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampschi2", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Chi]t2"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", "->", "1"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampsdeltam", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Delta]m"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", "->", "1"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<0PA\>\"", "->", "amps0PA"}], ",", 
       RowBox[{"\"\<1PA\>\"", "->", "amps1PA"}], ",", 
       RowBox[{"\"\<chi2\>\"", "->", "ampschi2"}], ",", 
       RowBox[{"\"\<chi1\>\"", "->", "ampschi1"}], ",", 
       RowBox[{"\"\<\[Delta]m\>\"", "->", "ampsdeltam"}]}], "|>"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9824015263185797`*^9, 3.982401527307852*^9}, {
   3.982401579650278*^9, 3.9824015965527267`*^9}, {3.982401662702693*^9, 
   3.982401678929369*^9}, 3.9824017195232058`*^9, {3.9824017649846354`*^9, 
   3.982401920332519*^9}, {3.9824019542092237`*^9, 3.982401995190321*^9}, {
   3.982405670468506*^9, 3.9824057430643806`*^9}, {3.9824059477072897`*^9, 
   3.9824061655359697`*^9}, {3.9824062008100986`*^9, 3.982406354889502*^9}, {
   3.982406390960506*^9, 3.982406393612095*^9}, {3.982407374169579*^9, 
   3.982407411762388*^9}, {3.982408252185164*^9, 3.982408281414947*^9}, {
   3.982408329029353*^9, 3.982408365879463*^9}, {3.982408410124034*^9, 
   3.982408449354397*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"043aef14-265d-483a-a1f3-80ad82b9f85d"],

