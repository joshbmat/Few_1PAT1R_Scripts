     "\[IndentingNewLine]", 
     RowBox[{"fullamp", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"WaSABI`Waveform`Private`GetAmplitudes", "[", 
          RowBox[{"\"\<1PAT1R\>\"", ",", 
           RowBox[{"{", "}"}]}], "]"}], "/.", 
         RowBox[{"{", " ", 
          RowBox[{
           RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Nu]", "->", "\[Nu]"}], ",", 
           
           RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[CapitalOmega]", "->", 
            SqrtBox[
             FractionBox["1", 
              SuperscriptBox["r0", "3"]]]}], ",", 
           RowBox[{"WaSABI`Inspiral`Model1PAT1R`M", "->", "1"}], ",", 
           RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Chi]t1", "->", "\[Chi]t1"}],
            ",", 
           RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Chi]t2", "->", "\[Chi]t2"}],
            ",", 
           RowBox[{
           "WaSABI`Inspiral`Model1PAT1R`\[Delta]m", "->", "\[Delta]m"}]}], 
          "}"}]}], ")"}], "[", "modestring", "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.982420163512323*^9, 3.982420200650547*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"63571a53-dc2b-433d-882b-9797f9576544"]
}, Closed]],

