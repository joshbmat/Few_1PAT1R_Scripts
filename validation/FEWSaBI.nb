 RowBox[{
  RowBox[{
  "py", "[", "\"\<from few.amplitude.ampinterp1d import AmpInterp1PAT1R\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"py", "[", "\"\<amp = AmpInterp1PAT1R()\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.9823986749171677`*^9, 3.982398781648025*^9}, {
  3.982399859159103*^9, 3.982399859547669*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"8ab69003-74f3-464e-a7e5-db127d94102c"],

Cell["Evaluating the amplitude pieces", "Text",
 CellChangeTimes->{{3.982400012513153*^9, 3.9824000173955297`*^9}, {
  3.9824009551347647`*^9, 
  3.982400956139484*^9}},ExpressionUUID->"00a00329-1837-4f62-8595-\
756b24365cd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetAmpsAtr0", "[", 
   RowBox[{"r0_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "string", ",", "amps0PA", ",", "amps1PA", ",", "ampschi2", ",", 
      "ampschi1", ",", "ampsdeltam", ",", "pos"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"ll", ",", "mm"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"ll", ",", "2", ",", "5"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"mm", ",", "1", ",", "ll"}], "}"}]}], "]"}], ",", 
            "1"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "m"}], "}"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"string", "=", 
      RowBox[{"\"\<amp.get_amplitudes_single_piece(0,\>\"", "<>", 
       RowBox[{"ToString", "[", "r0", "]"}], "<>", "\"\<, 0.0, 1.0,\>\""}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"amps0PA", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"py", "[", 
           RowBox[{"string", "<>", "\"\<data_key=\\\"0PA\\\")\>\""}], "]"}], 
          "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;"}], "]"}], "]"}], "[", 
       RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"amps1PA", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"py", "[", 
           RowBox[{"string", "<>", "\"\<data_key=\\\"1PA\\\")\>\""}], "]"}], 
          "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;"}], "]"}], "]"}], "[", 
       RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampschi2", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"py", "[", 
           RowBox[{"string", "<>", "\"\<data_key=\\\"1PAchi2\\\")\>\""}], 
           "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;"}], "]"}], "]"}], "[", 
       RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampschi1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"py", "[", 
           RowBox[{"string", "<>", "\"\<data_key=\\\"1PAchi1\\\")\>\""}], 
           "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;"}], "]"}], "]"}], "[", 
       RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampsdeltam", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Normal", "[", 
          RowBox[{"py", "[", 
           RowBox[{"string", "<>", "\"\<data_key=\\\"1PAdeltam\\\")\>\""}], 
           "]"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"5", ";;"}], "]"}], "]"}], "[", 
       RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<0PA\>\"", "->", "amps0PA"}], ",", 
       RowBox[{"\"\<1PA\>\"", "->", "amps1PA"}], ",", 
       RowBox[{"\"\<chi2\>\"", "->", "ampschi2"}], ",", 
       RowBox[{"\"\<chi1\>\"", "->", "ampschi1"}], ",", 
       RowBox[{"\"\<\[Delta]m\>\"", "->", "ampsdeltam"}]}], "|>"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9824003932565193`*^9, 3.9824004194471273`*^9}, {
  3.982400456190525*^9, 3.982400462735868*^9}, {3.982400492800066*^9, 
  3.9824008807457237`*^9}, {3.982406935906966*^9, 3.982406941308462*^9}, {
  3.982407025467441*^9, 3.9824070847688303`*^9}, {3.982407132634306*^9, 
  3.982407137358638*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"a01cedc8-5be2-4f7b-844d-1e67697433d7"],

