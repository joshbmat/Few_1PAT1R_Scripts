     "\[IndentingNewLine]", 
     RowBox[{"string1", "=", 
      RowBox[{"\"\<amp.get_amplitudes(0,\>\"", "<>", 
       RowBox[{"ToString", "[", "r0", "]"}], 
       "<>", "\"\<, 0.0, 1.0, nu=nu, chit=chit1,chit2=chit2, \
delta_m1=delta_m1, specific_modes=[\"<>modestring<>\"], zero_PA_amps_only = \
True )[\>\"", "<>", "modestring", "<>", "\"\<]\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Normal", "[", 
      RowBox[{"py", "[", "string1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.985332700617158*^9, 3.985332771225375*^9}, {
  3.985332933949143*^9, 3.985332941976385*^9}, {3.985332974311596*^9, 
  3.9853329851509*^9}, {3.985333030964438*^9, 3.985333080010167*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"1fb80d8f-0cf6-4372-ac06-e6bbbdb1a661"],

