  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{
  3.9824008959709387`*^9, 3.9824009827644176`*^9, 3.982405639660955*^9, {
   3.982406743911956*^9, 3.982406747540709*^9}, {3.982406909345614*^9, 
   3.982406945487771*^9}, 3.982407095146719*^9, {3.9824071427250338`*^9, 
   3.9824071537916183`*^9}, 3.982420080553176*^9, 3.984536512167803*^9, 
   3.9845384780197144`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"53f98c38-dd19-412b-b893-928039661c04"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetAmpsAtr0Combined", "[", 
   RowBox[{
   "r0_", ",", "l_", ",", "m_", ",", "\[Nu]_", ",", "chit1_", ",", "chit2_", ",",
     "deltam1_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"modestring", ",", "string1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"py", "[", 
      RowBox[{"\"\<nu=\>\"", "<>", 
       RowBox[{"ToString", "[", "\[Nu]", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<chit1=\>\"", "<>", 
       RowBox[{"ToString", "[", "chit1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<chit2=\>\"", "<>", 
       RowBox[{"ToString", "[", "chit2", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<delta_m1=\>\"", "<>", 
       RowBox[{"ToString", "[", "deltam1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"modestring", "=", 
      RowBox[{"\"\<(\>\"", "<>", 
       RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<,\>\"", "<>", 
       RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<,0,0)\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"string1", "=", 
      RowBox[{"\"\<amp.get_amplitudes(0,\>\"", "<>", 
       RowBox[{"ToString", "[", "r0", "]"}], 
       "<>", "\"\<, 0.0, 1.0, nu=nu, chit=chit1,chit2=chit2, \
delta_m1=delta_m1,specific_modes=[\>\"", "<>", "modestring", 
       "<>", "\"\<])[\>\"", "<>", "modestring", "<>", "\"\<]\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Normal", "[", 
      RowBox[{"py", "[", "string1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.982420281545622*^9, 3.982420307367696*^9}, {
