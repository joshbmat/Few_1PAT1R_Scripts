Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"m1val", "=", 
    SuperscriptBox["10", "6"]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"mass", " ", "in", " ", "Msun"}], "*)"}]}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{"m2val", "=", "10"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"mass", " ", "in", " ", "Msun"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]1val", "=", 
   RowBox[{"N", "[", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p0val", "=", 
   RowBox[{"N", "[", "9", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]val", "=", 
   RowBox[{"N", "[", 
    RowBox[{"\[Pi]", "/", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]2val", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Nu]val", "=", 
   RowBox[{"N", "[", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"m1val", "*", "m2val"}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"m1val", "+", "m2val"}], ")"}], "2"]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Mval", "=", 
   RowBox[{"N", "[", 
    RowBox[{"(", 
     RowBox[{"m1val", "+", "m2val"}], ")"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]t1val", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"4", "\[Nu]val"}]}]]}], ")"}], "\[Chi]1val"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]t2val", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SqrtBox[
        RowBox[{"1", "-", 
         RowBox[{"4", "\[Nu]val"}]}]]}], ")"}], "\[Chi]2val"}], "]"}]}], 
  ";"}]}], "Input",
