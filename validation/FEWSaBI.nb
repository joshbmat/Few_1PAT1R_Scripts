 RowBox[{
  RowBox[{"GetAmpsAtr0Combined2", "[", 
   RowBox[{
   "r0_", ",", "l_", ",", "m_", ",", "\[Nu]_", ",", "chit1_", ",", "chit2_", ",",
     "deltam1_"}], "]"}], ":=", 
