     RowBox[{"0.1343089726782492`", " ", "\[ImaginaryI]"}]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.985500906080991*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"6209837f-67c1-468f-af24-cacf6ded90f8"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetAmpsAtr0Combined", "[", 
   RowBox[{
   "r0_", ",", "l_", ",", "m_", ",", "\[Nu]_", ",", "chit1_", ",", "chit2_", ",",
     "deltam1_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"modestring", ",", "string1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"py", "[", 
      RowBox[{"\"\<nu=\>\"", "<>", 
       RowBox[{"ToString", "[", "\[Nu]", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<chit1=\>\"", "<>", 
       RowBox[{"ToString", "[", "chit1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
