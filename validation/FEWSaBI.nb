Cell["FEW waveforms in Mathematica:", "Subsubsection",
 CellChangeTimes->{{3.985419686304702*^9, 
  3.985419691357407*^9}},ExpressionUUID->"72eca1e0-4e66-4e91-8bbb-\
24b6e28213a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "PyBlock", 
   "[", "\"\<import numpy as np\nimport matplotlib.pyplot as plt\nfrom \
few.waveform import Waveform1PAT1R, FastKerrEccentricEquatorialFlux\n\nm1 = \
1e6       \nm2 = 10      \nchi1  = 1e-5\na = chi1 \np0 = 9.0      \ntheta = \
np.pi / 3.0   \nphi   = 0.0           \nchi2  = 0.1 \ndt = 1.  \nT  = 1   \n\n\
WF1PAT1R = Waveform1PAT1R()\nh = WF1PAT1R(m1, m2, a, p0, theta, phi, chi2, \
dt=dt, T=T)\>\"", "]"}], "//", "ToExpression"}]], "Input",
 CellChangeTimes->{{3.9854187562527227`*^9, 3.98541883384921*^9}, {
  3.9854189070048637`*^9, 3.9854189071806297`*^9}, {3.9854189500770197`*^9, 
