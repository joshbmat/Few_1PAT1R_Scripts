Cell[BoxData[
 RowBox[{
  RowBox[{"wasabiWaveform", "=", 
   RowBox[{"BinaryInspiral", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<\[CapitalOmega]\>\"", "->", 
        SqrtBox[
         RowBox[{"1", "/", 
          SuperscriptBox["p0val", "3"]}]]}], ",", 
       RowBox[{"\"\<\[Phi]\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<\[Nu]\>\"", "->", "\[Nu]val"}], ",", 
       RowBox[{"\"\<M\>\"", "->", "Mval"}], ",", 
       RowBox[{"\"\<\[Chi]t1\>\"", "->", "\[Chi]t1val"}], ",", 
       RowBox[{"\"\<\[Chi]t2\>\"", "->", "\[Chi]t2val"}], ",", 
       RowBox[{"\"\<\[Delta]m\>\"", "->", "0"}]}], "|>"}], ",", 
     RowBox[{"\"\<Model\>\"", "->", "\"\<1PAT1R\>\""}], ",", 
     RowBox[{"\"\<Precision\>\"", "->", "12"}], ",", 
     RowBox[{"\"\<Accuracy\>\"", "->", "12"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985421090421233*^9, 3.985421093973668*^9}, {
  3.985421131287578*^9, 3.985421133469327*^9}, {3.9854211862879677`*^9, 
  3.9854211866413383`*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"44e012ef-c06a-454c-8edf-e211d8a9cc77"],

Cell[BoxData[
 RowBox[{
  RowBox[{"slm", "[", 
   RowBox[{"l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
   RowBox[{
    RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]val", ",", "0"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.985419780286867*^9, 3.9854198167800417`*^9}, {
  3.9854213181688347`*^9, 3.9854213210017443`*^9}},
