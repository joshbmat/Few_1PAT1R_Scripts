Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Get", " ", "these", " ", "values", " ", "directly", " ", "from", " ", 
    "FEW"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "py", "[", "\"\<from few.utils.constants import MTSUN_SI, MRSUN_SI, \
YRSID_SI; print(MTSUN_SI, MRSUN_SI, YRSID_SI)\>\"", "]"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"MTSUN", "=", 
     RowBox[{"4.9254909476412675", "*", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "06"}], ")"}]}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"GM_sun", "/", 
      RowBox[{"c", "^", "3"}]}], " ", "in", " ", "seconds"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"MRSUN", "=", "1476.6250380501249"}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"GM_sun", "/", 
      RowBox[{"c", "^", "2"}]}], " ", "in", " ", "metres"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"waveform", "[", "t_", "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"MRSUN", "*", "muVal"}], ")"}], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"wasabiWaveform", "[", "\"\<Waveform\>\"", "]"}], "[", 
            RowBox[{"l", ",", "m"}], "]"}], "[", 
           RowBox[{"t", "/", 
            RowBox[{"(", 
             RowBox[{"MTSUN", "*", "Mval"}], ")"}]}], "]"}], "*", 
          RowBox[{"slm", "[", 
           RowBox[{"l", ",", "m"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "2", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "1", ",", "l"}], "}"}]}], "]"}]}]}], ";"}], 
    "*)"}]}]}]], "Input",
