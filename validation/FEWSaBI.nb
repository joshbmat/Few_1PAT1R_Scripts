      RowBox[{"\"\<Executable\>\"", 
       "\[Rule]", \
"\"\</Users/joshmathews/anaconda3/envs/1pat1r/bin/python\>\""}]}], "|>"}], 
    "]"}]}], ";"}]], "Input",
