Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"waveform", "[", "ts_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", "1", ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"wasabiWaveform", "[", "\"\<Waveform\>\"", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", 
          RowBox[{"ts", "/", 
           RowBox[{"(", "MTSUN", ")"}]}], "]"}], "*", 
         RowBox[{"slm", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "l"}], "}"}]}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"wasabiWaveform", "[", "\"\<Waveform\>\"", "]"}], "[", 
           RowBox[{"l", ",", "m"}], "]"}], "[", 
          RowBox[{"ts", "/", 
           RowBox[{"(", "MTSUN", ")"}]}], "]"}], "*", 
         RowBox[{"slm", "[", 
          RowBox[{"l", ",", "m"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
          RowBox[{"-", "l"}], ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985587473991415*^9, 3.985587492276031*^9}, {
   3.985587679516697*^9, 3.985587689575934*^9}, {3.985587976767235*^9, 
