Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Tick", " ", "helper"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"niceFrameTicks", "[", 
     RowBox[{"min_", ",", "max_", ",", 
      RowBox[{"n_", ":", "5"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"#", ",", 
        RowBox[{"NumberForm", "[", 
         RowBox[{
          RowBox[{"N", "[", "#", "]"}], ",", "3"}], "]"}]}], "}"}], "&"}], "/@", 
     RowBox[{"FindDivisions", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"min", ",", "max"}], "}"}], ",", "n"}], "]"}]}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "options"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotOpts", "=", 
     RowBox[{"Sequence", "[", 
      RowBox[{
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "4"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontSize", "->", "14"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Re[h]\>\"", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<t (s)\>\"", ",", "None"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "14"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Early", " ", "inspiral"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"first1000s", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"waveform", "[", "t", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "1000"}], "}"}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"tFEW", ",", 
             RowBox[{"Re", "[", 
              RowBox[{"\[Nu]val", "*", "Mval", "*", "waveformFEW"}], "]"}]}], 
            "}"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{";;", "1000"}], "]"}], "]"}], ",", 
         RowBox[{"Joined", "->", "True"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "2"}], "]"}], ",", "Dashed"}], "]"}]}]}], 
        "]"}], ",", "plotOpts", ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"niceFrameTicks", "[", 
             RowBox[{"0", ",", "1000"}], "]"}], ",", "None"}], "}"}]}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Late", " ", "inspiral"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"last1000s", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"waveform", "[", "t", "]"}], "]"}], ",", 
