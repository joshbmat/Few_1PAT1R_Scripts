    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"py", "[", "\"\<import matplotlib.pyplot as plt\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
