Cell[BoxData[
 RowBox[{
  RowBox[{"GetAmpsAtr0Combined", "[", 
   RowBox[{
   "r0_", ",", "l_", ",", "m_", ",", "\[Nu]_", ",", "chit1_", ",", "chit2_", ",",
     "deltam1_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"modestring", ",", "string1"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"py", "[", 
      RowBox[{"\"\<nu=\>\"", "<>", 
       RowBox[{"ToString", "[", "\[Nu]", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<chit1=\>\"", "<>", 
       RowBox[{"ToString", "[", "chit1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<chit2=\>\"", "<>", 
       RowBox[{"ToString", "[", "chit2", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"py", "[", 
      RowBox[{"\"\<delta_m1=\>\"", "<>", 
       RowBox[{"ToString", "[", "deltam1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"modestring", "=", 
      RowBox[{"\"\<(\>\"", "<>", 
       RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<,\>\"", "<>", 
       RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<,0,0)\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"string1", "=", 
      RowBox[{"\"\<amp.get_amplitudes(0,\>\"", "<>", 
       RowBox[{"ToString", "[", "r0", "]"}], 
       "<>", "\"\<, 0.0, 1.0, nu=nu, chit=chit1,chit2=chit2, \
delta_m1=delta_m1,specific_modes=[\>\"", "<>", "modestring", 
       "<>", "\"\<])[\>\"", "<>", "modestring", "<>", "\"\<]\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Normal", "[", 
      RowBox[{"py", "[", "string1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.982420281545622*^9, 3.982420307367696*^9}, {
  3.982420422205*^9, 3.9824204530871077`*^9}, {3.982420486311208*^9, 
  3.9824206007137403`*^9}, {3.982420636231482*^9, 3.9824208716054707`*^9}, {
  3.982420936115958*^9, 3.982420955220334*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"28b6c800-6faa-4bac-bbe8-078838c38801"],

