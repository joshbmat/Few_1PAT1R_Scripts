Cell[CellGroupData[{

Cell["Getting WaSABI amplitudes", "Subsubsection",
 CellChangeTimes->{{3.982401504182938*^9, 
  3.9824015102469673`*^9}},ExpressionUUID->"ab949f4c-e6f2-4f7c-a02a-\
5149320c8ae3"],

Cell[BoxData[
 RowBox[{"<<", "WaSABI`"}]], "Input",
 CellChangeTimes->{{3.982401273262446*^9, 3.9824012828768883`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"032cc182-83e3-4922-9827-773256394601"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetWaSABIAmps", "[", 
   RowBox[{"r0_", ",", "l_", ",", "m_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "fullamp", ",", "modestring", ",", "amps0PA", ",", "amps1PA", ",", 
      "ampschi2", ",", "ampschi1", ",", "ampsdeltam"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"modestring", "=", 
      RowBox[{"\"\<(\>\"", "<>", 
       RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<,\>\"", "<>", 
       RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<)\>\""}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fullamp", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "m", "]"}], ",", 
        RowBox[{
         FractionBox["1", 
          SqrtBox[
           RowBox[{"1", "-", 
            RowBox[{"4", "\[Nu]"}]}]]], 
         RowBox[{"(*", 
          RowBox[{
          "Accounting", " ", "for", " ", "resummed", " ", "odd", " ", "amp", " ",
            "vs", " ", "raw", " ", "data"}], "*)"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"WaSABI`Waveform`Private`GetAmplitudes", "[", 
             RowBox[{"\"\<1PAT1R\>\"", ",", 
              RowBox[{"{", "}"}]}], "]"}], "/.", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Nu]", "->", "\[Nu]"}], ",", 
              RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[CapitalOmega]", "->", 
               SqrtBox[
                FractionBox["1", 
                 SuperscriptBox["r0", "3"]]]}], ",", 
              RowBox[{"WaSABI`Inspiral`Model1PAT1R`M", "->", "1"}], ",", 
              RowBox[{
              "WaSABI`Inspiral`Model1PAT1R`\[Chi]t1", "->", "\[Chi]t1"}], ",", 
              RowBox[{
              "WaSABI`Inspiral`Model1PAT1R`\[Chi]t2", "->", "\[Chi]t2"}], ",", 
              RowBox[{
              "WaSABI`Inspiral`Model1PAT1R`\[Delta]m", "->", "\[Delta]m"}]}], 
             "}"}]}], ")"}], "[", "modestring", "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"WaSABI`Waveform`Private`GetAmplitudes", "[", 
            RowBox[{"\"\<1PAT1R\>\"", ",", 
             RowBox[{"{", "}"}]}], "]"}], "/.", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[Nu]", "->", "\[Nu]"}], ",", 
             RowBox[{"WaSABI`Inspiral`Model1PAT1R`\[CapitalOmega]", "->", 
              SqrtBox[
               FractionBox["1", 
                SuperscriptBox["r0", "3"]]]}], ",", 
             RowBox[{"WaSABI`Inspiral`Model1PAT1R`M", "->", "1"}], ",", 
             RowBox[{
             "WaSABI`Inspiral`Model1PAT1R`\[Chi]t1", "->", "\[Chi]t1"}], ",", 
             
             RowBox[{
             "WaSABI`Inspiral`Model1PAT1R`\[Chi]t2", "->", "\[Chi]t2"}], ",", 
             
             RowBox[{
             "WaSABI`Inspiral`Model1PAT1R`\[Delta]m", "->", "\[Delta]m"}]}], 
            "}"}]}], ")"}], "[", "modestring", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"amps0PA", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Nu]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Chi]t1", "->", "0"}], ",", 
         RowBox[{"\[Chi]t2", "->", "0"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"amps1PA", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", "m", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"fullamp", ",", 
             SuperscriptBox["\[Nu]", "2"]}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Chi]t1", "->", "0"}], ",", 
             RowBox[{"\[Chi]t2", "->", "0"}], ",", 
             RowBox[{"\[Delta]m", "->", "0"}]}], "}"}]}], ")"}], "-", 
         RowBox[{"2", "*", "amps0PA"}]}], ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Coefficient", "[", 
           RowBox[{"fullamp", ",", 
            SuperscriptBox["\[Nu]", "2"]}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Chi]t1", "->", "0"}], ",", 
            RowBox[{"\[Chi]t2", "->", "0"}], ",", 
            RowBox[{"\[Delta]m", "->", "0"}]}], "}"}]}], ")"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"ampschi1", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Chi]t1"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", "->", "1"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampschi2", "=", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"fullamp", ",", "\[Chi]t2"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", "->", "1"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ampsdeltam", "=", 
      RowBox[{
