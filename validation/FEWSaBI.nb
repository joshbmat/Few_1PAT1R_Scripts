Cell[CellGroupData[{

Cell["Functions for formatting python code.", "Section",
 CellChangeTimes->{{3.985415044943143*^9, 3.98541507570463*^9}, {
  3.985416159720107*^9, 3.985416216125403*^9}, {3.985416391677199*^9, 
  3.98541639236732*^9}},ExpressionUUID->"ac491c61-fc4a-45fd-ae48-\
e16ef61953b7"],

Cell["\<\
Below passing code_String=\[CloseCurlyDoubleQuote]print(\
\[OpenCurlyDoubleQuote]hello world \[OpenCurlyDoubleQuote])\
\[CloseCurlyDoubleQuote] will not work (fundamental issue with Mathematica \
syntax). Need to replace to code_String=\[CloseCurlyDoubleQuote]print(\\\
\[OpenCurlyDoubleQuote]hello world \\\[OpenCurlyDoubleQuote])\
\[CloseCurlyDoubleQuote]. \
\>", "Text",
 CellChangeTimes->{{3.985416218773074*^9, 3.985416268905388*^9}, 
   3.985416397055592*^9},ExpressionUUID->"0f0af7f0-8230-4a68-9cf7-\
696b43f43f74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Convert", " ", "a", " ", "multi"}], "-", 
    RowBox[{
    "line", " ", "Python", " ", "string", " ", "into", " ", "a", " ", "list", 
     " ", "of", " ", "individual", " ", 
     RowBox[{"py", "[", "\"\<...\>\"", "]"}], " ", "calls"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PyLines", "[", "code_String", "]"}], ":=", 
    RowBox[{
     RowBox[{"StringJoin", "[", 
      RowBox[{"Riffle", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\"\<py[\\\"\>\"", "<>", "#", "<>", "\"\<\\\"]\>\""}], 
          "&"}], "/@", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"StringSplit", "[", 
            RowBox[{"code", ",", "\"\<\\n\>\""}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"StringLength", "[", "#", "]"}], ">", "0"}], "&"}]}], 
          "]"}]}], ",", "\"\<;\\n\>\""}], "]"}], "]"}], "<>", "\"\<;\>\""}]}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Convert", " ", "a", " ", "multi"}], "-", 
     RowBox[{
     "line", " ", "Python", " ", "string", " ", "into", " ", "a", " ", 
      "single", " ", 
      RowBox[{"py", "[", "\"\<...\\n...\\n...\>\"", "]"}], " ", "call"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PyBlock", "[", "code_String", "]"}], ":=", 
    RowBox[{"\"\<py[\\\"\>\"", "<>", 
     RowBox[{"StringReplace", "[", 
      RowBox[{
       RowBox[{"StringTrim", "[", "code", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<\\n\>\"", "->", "\"\<\\\\n\>\""}], ",", 
         RowBox[{"\"\<\\\"\>\"", "->", "\"\<\\\\\\\"\>\""}], ",", 
         RowBox[{"\"\<\\\\\>\"", "->", "\"\<\\\\\\\\\>\""}]}], "}"}]}], "]"}],
      "<>", "\"\<\\\"];\>\""}]}]}]}]], "Input",
 CellChangeTimes->{{3.9854150609911947`*^9, 3.9854150609924603`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"f06ab2b6-1ca3-4d82-ab92-7999980247aa"],

