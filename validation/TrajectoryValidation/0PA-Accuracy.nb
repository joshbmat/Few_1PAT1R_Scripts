Cell[TextData[StyleBox["Scale \[Phi] by \[Epsilon] - this allows us to reach \
higher mass ratios/integration times, but doesn\[CloseCurlyQuote]t change the \
fundamental accuracy", "Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.985326123327004*^9, 3.98532612851394*^9}, {
