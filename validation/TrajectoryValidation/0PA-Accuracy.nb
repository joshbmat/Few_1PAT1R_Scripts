Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
   "\[ScriptCapitalF]\[ScriptCapitalE]\[ScriptCapitalI]2", "[", "p_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     FractionBox["32", "5"], 
     SuperscriptBox["p", 
      RowBox[{"-", "5"}]], 
     RowBox[{
      RowBox[{"Interpolation", "[", 
       RowBox[{
        RowBox[{"Downsample", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"pGrid", ",", 
             
             FractionBox[
              "\[ScriptCapitalF]\[ScriptCapitalE]\[ScriptCapitalI]data", 
              RowBox[{
               FractionBox["32", "5"], 
               SuperscriptBox["pGrid", 
                RowBox[{"-", "5"}]]}]]}], "}"}], "]"}], ",", 
