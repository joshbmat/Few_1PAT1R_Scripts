Cell[BoxData[
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]\[Epsilon]solPG12", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"\[Phi]\[Epsilon]solPG12", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"r0\[Epsilon]solPG12", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[CapitalOmega]", "'"}], "[", "t", "]"}], "\[Equal]", 
          FractionBox[
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"3", " ", 
                RowBox[{"M", "/", 
                 RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}], 
             RowBox[{"3", "/", "2"}]], " ", 
            SqrtBox[
             RowBox[{"M", "/", 
              RowBox[{"r0", "[", "t", "]"}]}]], " ", 
            RowBox[{"\[ScriptCapitalF]\[ScriptCapitalE]", "[", 
             RowBox[{"r0", "[", "t", "]"}], "]"}], " ", "\[Epsilon]"}], 
           RowBox[{
            SuperscriptBox["M", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"6", " ", 
               RowBox[{"M", "/", 
                RowBox[{"r0", "[", "t", "]"}]}]}]}], ")"}]}]]}], ",", " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "\[Epsilon]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[CapitalOmega]", "[", "t", "]"}], "==", 
          RowBox[{"Sqrt", "[", 
           FractionBox["M", 
            SuperscriptBox[
             RowBox[{"r0", "[", "t", "]"}], "3"]], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"r0", "[", "0", "]"}], "\[Equal]", 
          RowBox[{"15", "M"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"WhenEvent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"r0", "[", "t", "]"}], "\[LessEqual]", 
            RowBox[{"6.1", "M"}]}], ",", " ", "\"\<StopIntegration\>\""}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalOmega]", ",", "\[Phi]", ",", "r0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
       RowBox[{"PrecisionGoal", "->", "12"}], ",", 
       RowBox[{"AccuracyGoal", "->", "12"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tmin\[Epsilon]PG12", "[", "\[Epsilon]", "]"}], ",", 
       RowBox[{"tmax\[Epsilon]PG12", "[", "\[Epsilon]", "]"}]}], "}"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"r0sol", "[", "\[Epsilon]", "]"}], "[", "\"\<Domain\>\"", 
       "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Epsilon]", ",", "\[Epsilon]s"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.985325834695066*^9, 3.985326040356366*^9}, {
   3.985326092698344*^9, 3.9853260932625933`*^9}, {3.985326214740563*^9, 
   3.985326248761726*^9}, 3.985326957073206*^9, {3.98532788190653*^9, 
   3.985327898594636*^9}, 3.985333982074884*^9, {3.9853496375725594`*^9, 
   3.985349638712945*^9}, {3.9853497236095037`*^9, 3.985349750254869*^9}, {
   3.985366167825925*^9, 3.9853661692488003`*^9}, {3.985366325492835*^9, 
   3.985366345761816*^9}, {3.9854057372799053`*^9, 3.985405751163473*^9}, {
   3.985405954996863*^9, 3.9854059621487226`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"d61894f0-ab22-4520-950c-ed041f21de35"],

