      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ListLogLogPlot", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
