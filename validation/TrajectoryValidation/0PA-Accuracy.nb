Cell[TextData[StyleBox["Scale \[Phi] by \[Epsilon] and increase PrecisionGoal \
and AccuracyGoal - this decreases phase error", "Subsubsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.985326123327004*^9, 3.98532612851394*^9}, {
  3.985333099084257*^9, 3.9853331143275347`*^9}, {3.985349620346974*^9, 
  3.985349627465631*^9}, {3.985405361451088*^9, 3.985405388238679*^9}, {
