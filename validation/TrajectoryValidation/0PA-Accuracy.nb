Cell[TextData[{
 "This fails for sufficiently small mass ratio ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "\[LessTilde]", 
    SuperscriptBox["10", 
     RowBox[{"-", "7"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f244228a-8f13-4a5f-8b78-6ada0117566f"],
 " and long inspiral times. This is because the total phase evolution is \
large, so that reaching the accuracy goal requires greater than machine \
precision. Let\[CloseCurlyQuote]s look at the dephasing anyway, but keep in \
mind that for the smallest three mass ratios we\[CloseCurlyQuote]re not \
reaching ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", "6.1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4930d240-b1f2-4af8-8bd7-386fad1af8b5"],
 "."
}], "Text",
 CellChangeTimes->{{3.9853335497077293`*^9, 3.985333625272369*^9}, {
  3.985333872484865*^9, 3.9853339378806*^9}, {3.985334028813789*^9, 
